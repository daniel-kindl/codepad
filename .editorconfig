root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[*.{json,yml,yaml,xml,props,targets,csproj,slnx}]
indent_size = 2

[*.cs]
# Brace style: Allman. See dkstack coding/brace-style.md.
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# Naming. See dkstack coding/naming.md. The build reports a violation as an error (IDE1006).
dotnet_diagnostic.IDE1006.severity = error
dotnet_naming_rule.interfaces_are_i_pascal_case.symbols = interfaces
dotnet_naming_rule.interfaces_are_i_pascal_case.style = i_pascal_case
dotnet_naming_rule.interfaces_are_i_pascal_case.severity = error

dotnet_naming_rule.constants_are_upper_snake_case.symbols = constants
dotnet_naming_rule.constants_are_upper_snake_case.style = upper_snake_case
dotnet_naming_rule.constants_are_upper_snake_case.severity = error

dotnet_naming_rule.types_are_pascal_case.symbols = types
dotnet_naming_rule.types_are_pascal_case.style = pascal_case
dotnet_naming_rule.types_are_pascal_case.severity = error

dotnet_naming_rule.members_are_pascal_case.symbols = members
dotnet_naming_rule.members_are_pascal_case.style = pascal_case
dotnet_naming_rule.members_are_pascal_case.severity = error

dotnet_naming_rule.locals_and_parameters_are_camel_case.symbols = locals_and_parameters
dotnet_naming_rule.locals_and_parameters_are_camel_case.style = camel_case
dotnet_naming_rule.locals_and_parameters_are_camel_case.severity = error

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.constants.applicable_kinds = field, local
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_symbols.types.applicable_kinds = class, struct, enum, delegate, record
dotnet_naming_symbols.members.applicable_kinds = method, property, event
dotnet_naming_symbols.locals_and_parameters.applicable_kinds = parameter, local

dotnet_naming_style.i_pascal_case.required_prefix = I
dotnet_naming_style.i_pascal_case.capitalization = pascal_case
dotnet_naming_style.upper_snake_case.capitalization = all_upper
dotnet_naming_style.upper_snake_case.word_separator = _
dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case
