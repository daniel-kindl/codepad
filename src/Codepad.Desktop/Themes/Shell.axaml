<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="using:AvaloniaEdit">

  <!-- Styles of the shell regions. The colors come from Tokens.axaml. -->

  <Style Selector="Menu">
    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <Style Selector="Border.status-region">
    <Setter Property="Background" Value="{DynamicResource ShellStatusBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="{StaticResource ShellStatusPadding}" />
  </Style>

  <Style Selector="TextBlock.status">
    <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource ShellBodyFontSize}" />
  </Style>

  <Style Selector="TextBlock.status.warning">
    <Setter Property="Foreground" Value="{DynamicResource ShellWarningTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="StackPanel.empty-state">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="MaxWidth" Value="440" />
    <Setter Property="Margin" Value="24" />
    <Setter Property="Spacing" Value="8" />
  </Style>

  <Style Selector="TextBlock.empty-title">
    <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource ShellTitleFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.empty-body">
    <Setter Property="Foreground" Value="{DynamicResource ShellMutedTextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource ShellBodyFontSize}" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- The C# editor and its diagnostics list. -->

  <Style Selector="ae|TextEditor.code-editor">
    <Setter Property="Background" Value="{DynamicResource ShellWorkspaceBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
    <Setter Property="LineNumbersForeground" Value="{DynamicResource ShellMutedTextBrush}" />
    <Setter Property="Padding" Value="4" />
  </Style>

  <Style Selector="ListBox.diagnostic-list">
    <Setter Property="Background" Value="{DynamicResource ShellWorkspaceBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>

  <Style Selector="TextBlock.diagnostic-severity">
    <Setter Property="Foreground" Value="{DynamicResource EditorInfoBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinWidth" Value="56" />
  </Style>
  <Style Selector="TextBlock.diagnostic-severity.error">
    <Setter Property="Foreground" Value="{DynamicResource EditorErrorBrush}" />
  </Style>
  <Style Selector="TextBlock.diagnostic-severity.warning">
    <Setter Property="Foreground" Value="{DynamicResource EditorWarningBrush}" />
  </Style>

  <Style Selector="TextBlock.diagnostic-place">
    <Setter Property="Foreground" Value="{DynamicResource ShellMutedTextBrush}" />
  </Style>

  <Style Selector="TextBlock.diagnostic-message">
    <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
  </Style>

  <!-- The completion list rows. The kind is a word, so the row does not depend on color. -->

  <Style Selector="TextBlock.completion-kind">
    <Setter Property="Foreground" Value="{DynamicResource ShellMutedTextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource ShellBodyFontSize}" />
  </Style>
  <Style Selector="TextBlock.completion-name">
    <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource EditorFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource ShellBodyFontSize}" />
  </Style>
  <Style Selector="TextBlock.completion-detail">
    <Setter Property="Foreground" Value="{DynamicResource ShellMutedTextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource ShellBodyFontSize}" />
  </Style>

  <!-- The result panel. -->

  <Style Selector="Border.results-header">
    <Setter Property="Background" Value="{DynamicResource ShellStatusBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,1" />
    <Setter Property="Padding" Value="{StaticResource ShellStatusPadding}" />
  </Style>

  <Style Selector="TextBlock.run-status">
    <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="{StaticResource ShellBodyFontSize}" />
  </Style>
  <Style Selector="TextBlock.run-status.success">
    <Setter Property="Foreground" Value="{DynamicResource EditorSuccessBrush}" />
  </Style>
  <Style Selector="TextBlock.run-status.error">
    <Setter Property="Foreground" Value="{DynamicResource EditorErrorBrush}" />
  </Style>
  <Style Selector="TextBlock.run-status.warning">
    <Setter Property="Foreground" Value="{DynamicResource EditorWarningBrush}" />
  </Style>

  <Style Selector="TextBlock.run-info">
    <Setter Property="Foreground" Value="{DynamicResource ShellMutedTextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource ShellBodyFontSize}" />
  </Style>

  <Style Selector="TextBlock.notice">
    <Setter Property="Foreground" Value="{DynamicResource ShellWarningTextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource ShellBodyFontSize}" />
    <Setter Property="Margin" Value="8,6" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBox.value-text">
    <Setter Property="FontFamily" Value="{StaticResource EditorFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource EditorFontSize}" />
    <Setter Property="Background" Value="{DynamicResource ShellWorkspaceBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="TextBlock.tree-label">
    <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.tree-summary">
    <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource EditorFontFamily}" />
  </Style>
  <Style Selector="TextBlock.tree-type">
    <Setter Property="Foreground" Value="{DynamicResource ShellMutedTextBrush}" />
  </Style>
  <Style Selector="DataGrid">
    <Setter Property="Background" Value="{DynamicResource ShellWorkspaceBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource ShellStatusBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ShellTextBrush}" />
  </Style>
  <Style Selector="DataGridRow">
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="TabControl > TabItem">
    <Setter Property="FontSize" Value="{StaticResource ShellBodyFontSize}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="12,6" />
  </Style>
  <Style Selector="TreeView > TreeViewItem">
    <Setter Property="IsExpanded" Value="True" />
  </Style>

</Styles>
