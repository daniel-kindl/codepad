<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Codepad.Desktop.Shell"
        x:Class="Codepad.Desktop.Shell.MainWindow"
        x:DataType="shell:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1100" Height="720"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ShellWorkspaceBackgroundBrush}">

  <DockPanel>

    <Menu DockPanel.Dock="Top" AutomationProperties.Name="Main menu">
      <MenuItem Header="_File">
        <MenuItem Header="E_xit" AutomationProperties.Name="Exit" Click="OnExitClick" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Bottom" Classes="status-region">
      <TextBlock Classes="status"
                 Classes.warning="{Binding HasWarning}"
                 Text="{Binding StatusText}"
                 TextWrapping="Wrap"
                 AutomationProperties.Name="Status"
                 AutomationProperties.LiveSetting="Polite" />
    </Border>

    <Grid AutomationProperties.Name="Workspace">
      <StackPanel Classes="empty-state">
        <TextBlock Classes="empty-title" Text="Nothing open yet" />
        <TextBlock Classes="empty-body"
                   Text="Experiments will open here. You can't create or run them in this build yet." />
      </StackPanel>
    </Grid>

  </DockPanel>

</Window>
