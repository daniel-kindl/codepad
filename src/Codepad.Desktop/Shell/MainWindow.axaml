<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Codepad.Desktop.Shell"
        xmlns:editor="using:Codepad.Desktop.Editor"
        xmlns:results="using:Codepad.Desktop.Results"
        xmlns:history="using:Codepad.Desktop.History"
        x:Class="Codepad.Desktop.Shell.MainWindow"
        x:DataType="shell:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1100" Height="720"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ShellWorkspaceBackgroundBrush}">

  <DockPanel>

    <Menu DockPanel.Dock="Top" AutomationProperties.Name="Main menu">
      <MenuItem Header="_File" AutomationProperties.Name="File">
        <MenuItem Header="E_xit" AutomationProperties.Name="Exit" Click="OnExitClick" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Bottom" Classes="status-region">
      <TextBlock Classes="status"
                 Classes.warning="{Binding HasWarning}"
                 Text="{Binding StatusText}"
                 TextWrapping="Wrap"
                 AutomationProperties.Name="Status"
                 AutomationProperties.LiveSetting="Polite" />
    </Border>

    <Border DockPanel.Dock="Right" Width="300" IsVisible="{Binding HasHistory}"
            BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1,0,0,0">
      <history:RunHistoryView DataContext="{Binding History}" />
    </Border>

    <Grid AutomationProperties.Name="Workspace">
      <Grid.RowDefinitions>
        <RowDefinition Height="3*" MinHeight="140" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="2*" MinHeight="120" />
      </Grid.RowDefinitions>
      <editor:CSharpEditorView Grid.Row="0" DataContext="{Binding Editor}" />
      <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" ResizeDirection="Rows" Focusable="False"
                    Background="{DynamicResource ShellBorderBrush}" AutomationProperties.Name="Resize the result panel" />
      <results:ResultsView Grid.Row="2" DataContext="{Binding Results}" />
    </Grid>

  </DockPanel>

</Window>
