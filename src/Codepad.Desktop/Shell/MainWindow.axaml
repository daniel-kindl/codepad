<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Codepad.Desktop.Shell"
        xmlns:editor="using:Codepad.Desktop.Editor"
        xmlns:results="using:Codepad.Desktop.Results"
        xmlns:history="using:Codepad.Desktop.History"
        xmlns:workspace="using:Codepad.Desktop.Workspace"
        xmlns:library="using:Codepad.Desktop.Library"
        xmlns:commands="using:Codepad.Desktop.Commands"
        x:Class="Codepad.Desktop.Shell.MainWindow"
        x:DataType="shell:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1100" Height="720"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ShellWorkspaceBackgroundBrush}">

  <Panel>
  <DockPanel>

    <Menu DockPanel.Dock="Top" AutomationProperties.Name="Main menu">
      <MenuItem Header="_File" AutomationProperties.Name="File">
        <MenuItem Header="New _C# experiment" IsEnabled="{Binding HasWorkspace}" Click="OnNewCSharpClick" AutomationProperties.Name="New C# experiment" />
        <MenuItem Header="New _JSON experiment" IsEnabled="{Binding HasWorkspace}" Click="OnNewJsonClick" AutomationProperties.Name="New JSON experiment" />
        <MenuItem Header="Close _tab" InputGesture="Ctrl+W" IsEnabled="{Binding HasWorkspace}" Click="OnCloseTabClick" AutomationProperties.Name="Close tab" />
        <Separator />
        <MenuItem Header="_Next tab" InputGesture="Ctrl+Tab" IsEnabled="{Binding HasWorkspace}" Click="OnNextTabClick" AutomationProperties.Name="Next tab" />
        <MenuItem Header="_Previous tab" InputGesture="Ctrl+Shift+Tab" IsEnabled="{Binding HasWorkspace}" Click="OnPreviousTabClick" AutomationProperties.Name="Previous tab" />
        <Separator />
        <MenuItem Header="E_xit" AutomationProperties.Name="Exit" Click="OnExitClick" />
      </MenuItem>
      <MenuItem Header="_Run" AutomationProperties.Name="Run">
        <MenuItem Header="_Run C#" InputGesture="Ctrl+Enter" IsEnabled="{Binding HasWorkspace}" Click="OnRunClick" AutomationProperties.Name="Run C#" />
        <MenuItem Header="_Cancel run" IsEnabled="{Binding HasWorkspace}" Click="OnCancelRunClick" AutomationProperties.Name="Cancel run" />
      </MenuItem>
      <MenuItem Header="_View" AutomationProperties.Name="View">
        <MenuItem Header="_Command palette" InputGesture="Ctrl+K" IsEnabled="{Binding HasWorkspace}" Click="OnOpenPaletteClick" AutomationProperties.Name="Command palette" />
        <MenuItem Header="_Library" IsEnabled="{Binding HasLibrary}" Click="OnToggleLibraryClick" AutomationProperties.Name="Show or hide the library" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Bottom" Classes="status-region">
      <StackPanel Spacing="2">
        <TextBlock Classes="status"
                   Classes.warning="{Binding HasWarning}"
                   Text="{Binding StatusText}"
                   TextWrapping="Wrap"
                   AutomationProperties.Name="Status"
                   AutomationProperties.LiveSetting="Polite" />
        <TextBlock Classes="status"
                   Text="{Binding Workspace.ActiveSaveText}"
                   IsVisible="{Binding Workspace.ActiveSaveText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   TextWrapping="Wrap"
                   AutomationProperties.Name="Save status"
                   AutomationProperties.LiveSetting="Polite" />
        <TextBlock Classes="status warning"
                   Text="{Binding Workspace.Notice}"
                   IsVisible="{Binding Workspace.Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   TextWrapping="Wrap"
                   AutomationProperties.Name="Tab notice"
                   AutomationProperties.LiveSetting="Assertive" />
      </StackPanel>
    </Border>

    <Border x:Name="LibraryPanel" DockPanel.Dock="Left" Width="280" IsVisible="{Binding HasLibrary}"
            BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="0,0,1,0">
      <library:LibraryView x:Name="LibraryContent" DataContext="{Binding Library}" />
    </Border>

    <Border DockPanel.Dock="Right" Width="300" IsVisible="{Binding HasHistory}"
            BorderBrush="{DynamicResource ShellBorderBrush}" BorderThickness="1,0,0,0">
      <history:RunHistoryView DataContext="{Binding History}" />
    </Border>

    <Panel>
      <Border IsVisible="{Binding HasWorkspace}">
        <workspace:WorkspaceView DataContext="{Binding Workspace}" />
      </Border>

      <Grid AutomationProperties.Name="Workspace" IsVisible="{Binding HasNoWorkspace}">
        <Grid.RowDefinitions>
          <RowDefinition Height="3*" MinHeight="140" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="2*" MinHeight="120" />
        </Grid.RowDefinitions>
        <editor:CSharpEditorView Grid.Row="0" DataContext="{Binding Editor}" />
        <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" ResizeDirection="Rows" Focusable="False"
                      Background="{DynamicResource ShellBorderBrush}" AutomationProperties.Name="Resize the result panel" />
        <results:ResultsView Grid.Row="2" DataContext="{Binding Results}" />
      </Grid>
    </Panel>

  </DockPanel>

  <commands:CommandPaletteView x:Name="PaletteView" />
  </Panel>

</Window>
