<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:results="using:Codepad.Desktop.Results"
             x:Class="Codepad.Desktop.Results.ResultsView"
             x:DataType="results:ResultsViewModel">

  <Grid RowDefinitions="Auto,*" AutomationProperties.Name="Run results">

    <Border Grid.Row="0" Classes="results-header">
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right"
                Content="Copy result"
                IsEnabled="{Binding CanCopy}"
                Click="OnCopyClick"
                AutomationProperties.Name="Copy result as JSON" />
        <StackPanel Spacing="2">
          <TextBlock Classes="run-status"
                     Classes.success="{Binding StatusKind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=success}"
                     Classes.error="{Binding StatusKind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=error}"
                     Classes.warning="{Binding StatusKind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=warning}"
                     Text="{Binding StatusText}"
                     AutomationProperties.Name="Run status"
                     AutomationProperties.LiveSetting="Polite" />
          <TextBlock Classes="run-info" Text="{Binding ExecutionText}" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="notice" Margin="0"
                     IsVisible="{Binding CopyNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Text="{Binding CopyNotice}"
                     AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </DockPanel>
    </Border>

    <TabControl Grid.Row="1" AutomationProperties.Name="Run output">

      <TabItem Header="Result">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="notice"
                     IsVisible="{Binding IsShowingPrevious}"
                     Text="This run has no value of its own. The panel shows the value of the last successful run." />
          <TextBlock DockPanel.Dock="Top" Classes="notice"
                     IsVisible="{Binding TruncationText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Text="{Binding TruncationText}"
                     AutomationProperties.Name="Truncation notice" />
          <Grid>
            <TextBlock Classes="empty-body" IsVisible="{Binding IsEmpty}" Text="{Binding EmptyText}" Margin="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBox x:Name="ValueBox" Classes="value-text" IsVisible="{Binding IsText}"
                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     Text="{Binding ValueText, Mode=OneWay}"
                     AutomationProperties.Name="Result value" />
            <TreeView x:Name="ValueTree" IsVisible="{Binding IsTree}" ItemsSource="{Binding Tree}"
                      AutomationProperties.Name="Result tree">
              <TreeView.ItemTemplate>
                <TreeDataTemplate x:DataType="results:ResultTreeItem" ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal" Spacing="8" AutomationProperties.Name="{Binding AccessibleName}">
                    <TextBlock Classes="tree-label" Text="{Binding Label}" />
                    <TextBlock Classes="tree-summary" Text="{Binding Summary}" />
                    <TextBlock Classes="tree-type" Text="{Binding TypeText}" />
                  </StackPanel>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
            <DataGrid x:Name="ValueGrid" IsVisible="{Binding IsTable}"
                      IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="False"
                      CanUserResizeColumns="True" GridLinesVisibility="All"
                      AutomationProperties.Name="Result table" />
          </Grid>
        </DockPanel>
      </TabItem>

      <TabItem Header="{Binding DiagnosticsTitle}">
        <Grid>
          <TextBlock Classes="empty-body" Margin="12" Text="No problems in this run."
                     IsVisible="{Binding !Diagnostics.Count}" />
          <ListBox ItemsSource="{Binding Diagnostics}" AutomationProperties.Name="Run problems">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="results:RunDiagnosticRow">
                <StackPanel Orientation="Horizontal" Spacing="8" AutomationProperties.Name="{Binding AccessibleName}">
                  <TextBlock Classes="diagnostic-severity"
                             Classes.error="{Binding SeverityText, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Error}"
                             Classes.warning="{Binding SeverityText, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Warning}"
                             Text="{Binding SeverityText}" />
                  <TextBlock Classes="diagnostic-place" Text="{Binding PlaceText}" />
                  <TextBlock Classes="diagnostic-message" Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </TabItem>

      <TabItem Header="Output">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="notice"
                     IsVisible="{Binding StdoutNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Text="{Binding StdoutNote}" />
          <TextBox Classes="value-text" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                   Text="{Binding Stdout, Mode=OneWay}" PlaceholderText="This run wrote nothing to standard output."
                   AutomationProperties.Name="Standard output" />
        </DockPanel>
      </TabItem>

      <TabItem Header="Errors">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="notice"
                     IsVisible="{Binding StderrNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Text="{Binding StderrNote}" />
          <TextBox Classes="value-text" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                   Text="{Binding Stderr, Mode=OneWay}" PlaceholderText="This run wrote nothing to standard error."
                   AutomationProperties.Name="Standard error" />
        </DockPanel>
      </TabItem>

    </TabControl>

  </Grid>

</UserControl>
