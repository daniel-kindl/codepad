<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:json="using:Codepad.Desktop.Json"
             xmlns:results="using:Codepad.Desktop.Results"
             x:Class="Codepad.Desktop.Json.JsonToolView"
             x:DataType="json:JsonToolViewModel">

  <Grid RowDefinitions="3*,Auto,Auto,2*" AutomationProperties.Name="JSON tool">

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,*">
      <TextBox x:Name="InputBox"
               Grid.Column="0"
               AcceptsReturn="True"
               AcceptsTab="True"
               TextWrapping="NoWrap"
               FontFamily="{StaticResource EditorFontFamily}"
               FontSize="{StaticResource EditorFontSize}"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               PlaceholderText="Type or paste JSON"
               AutomationProperties.Name="JSON input" />
      <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns" Focusable="False"
                    Background="{DynamicResource ShellBorderBrush}" AutomationProperties.Name="Resize the formatted preview" />
      <TextBox x:Name="FormattedBox"
               Grid.Column="2"
               IsReadOnly="True"
               AcceptsReturn="True"
               TextWrapping="NoWrap"
               FontFamily="{StaticResource EditorFontFamily}"
               FontSize="{StaticResource EditorFontSize}"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               Text="{Binding FormattedText, Mode=OneWay}"
               AutomationProperties.Name="Formatted JSON" />
    </Grid>

    <Border Grid.Row="1" Classes="status-region">
      <TextBlock Classes="status"
                 Classes.warning="{Binding HasProblem}"
                 Text="{Binding SummaryText}"
                 TextWrapping="Wrap"
                 AutomationProperties.Name="JSON status"
                 AutomationProperties.LiveSetting="Polite" />
    </Border>

    <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" ResizeDirection="Rows" Focusable="False"
                  Background="{DynamicResource ShellBorderBrush}" AutomationProperties.Name="Resize the result panel" />

    <results:ResultsView Grid.Row="3" DataContext="{Binding Results}" />

  </Grid>

</UserControl>
