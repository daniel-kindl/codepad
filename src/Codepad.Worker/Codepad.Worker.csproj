<Project Sdk="Microsoft.NET.Sdk">

  <!-- The child process that compiles and runs one C# snippet with Roslyn. It is a crash boundary, not a sandbox. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Codepad.Contracts\Codepad.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Codepad.Tests" />
  </ItemGroup>

</Project>
